{
    "baseline": "url_embed_flat_fc64_binary_v3",
    "type": "modify_model",
    "model_family": "url_embedding_classifier",
    "shared_layer": [
        {
            "op": "modify",
            "name": "fc1",
            "class": "Linear",
            "params": {
                "in_features": "maxlen * embed_dim",
                "out_features": 512
            },
            "reason": "increase representation capacity after flattening embeddings"
        },
        {
            "op": "add",
            "name": "fc2",
            "class": "Linear",
            "params": {
                "in_features": 512,
                "out_features": 256
            },
            "reason": "gradual dimensionality reduction to stabilize training"
        }
    ],
    "personal_layer": [
        {
            "op": "add",
            "name": "fc3",
            "class": "Linear",
            "params": {
                "in_features": 256,
                "out_features": 128
            },
            "reason": "introduce deeper personalization and non-linearity"
        },
        {
            "op": "add",
            "name": "fc4",
            "class": "Linear",
            "params": {
                "in_features": 128,
                "out_features": 64
            },
            "reason": "compress features before binary decision head"
        }
    ],
    "forward": [
        "x = embedding(x)",
        "x = flatten(x, start_dim=1)",
        "x = fc1(x)",
        "x = fc2(x)",
        "x = fc3(x)",
        "x = fc4(x)",
        "x = head(x)",
        "x = sigmoid(x)"
    ],
    "summary": {
        "changes": [
            "expanded MLP width (512 \u2192 256 \u2192 128 \u2192 64)",
            "removed convolutional stack to isolate embedding-only behavior",
            "aimed at smoother optimization and richer decision boundaries"
        ],
        "ablation_goal": "measure effect of deep MLP depth vs shallow FC head"
    },
    "output": {
        "task": "binary_classification",
        "activation": "sigmoid"
    }
}