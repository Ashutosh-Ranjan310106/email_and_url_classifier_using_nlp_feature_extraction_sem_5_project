{
    "baseline": "url_embed_flat_mlp512_256_ln_gelu_128_head_binary_v7",
    "type": "modify_model",
    "model_family": "url_embedding_classifier",
    "shared_layer": [
        {
            "op": "add",
            "name": "dropout_fc1",
            "class": "Dropout",
            "params": {
                "p": 0.5
            },
            "after": "gelu_fc1",
            "reason": "reduce overfitting after high-capacity FC layer"
        },
        {
            "op": "reorder",
            "pattern": "fc2 -> layer_norm -> gelu",
            "new_pattern": "fc2 -> layer_norm -> gelu -> dropout",
            "reason": "apply regularization after non-linearity"
        },
        {
            "op": "add",
            "name": "dropout_fc2",
            "class": "Dropout",
            "params": {
                "p": 0.5
            },
            "after": "gelu_fc2",
            "reason": "stabilize mid-level representations"
        }
    ],
    "personal_layer": [
        {
            "op": "add",
            "name": "dropout_fc3",
            "class": "Dropout",
            "params": {
                "p": 0.5
            },
            "after": "gelu_fc3",
            "reason": "strong regularization before classification head"
        }
    ],
    "forward": [
        "x = embedding(x)",
        "x = flatten(x, start_dim=1)",
        "x = fc1(x) -> gelu -> dropout",
        "x = fc2(x) -> layer_norm -> gelu -> dropout",
        "x = fc3(x) -> gelu -> dropout",
        "x = head(x)",
        "x = sigmoid(x)"
    ],
    "summary": {
        "changes": [
            "introduced dropout after each major FC block",
            "combined GELU with dropout for smooth regularization",
            "kept LayerNorm only at bottleneck layer (256)"
        ],
        "expected_effect": [
            "reduced overfitting",
            "better generalization on unseen URLs",
            "slightly slower convergence"
        ]
    },
    "regularization": {
        "dropout_rate": 0.5,
        "layer_norm": "mid-level only"
    },
    "output": {
        "task": "binary_classification",
        "activation": "sigmoid"
    }
}