{
    "base_version": "v24",
    "architecture_family": "ResMK_CNN_BiLSTM_StridedCNN",
    "embedding": {
        "embed_dim": 64,
        "d_model": 128
    },
    "cnn_backbone": {
        "block_type": "ResidualMultiKernel",
        "num_blocks": 2,
        "channels": [
            64,
            32
        ],
        "kernel_sizes": [
            3,
            5,
            7
        ],
        "dilations": [
            1,
            2
        ],
        "stride": 1,
        "normalization": "GroupNorm",
        "residual": true
    },
    "sequence_model": {
        "type": "BiLSTM",
        "input_size": 32,
        "hidden_size": 32,
        "num_layers": 1,
        "bidirectional": true,
        "post_norm": "LayerNorm",
        "post_activation": "GELU"
    },
    "post_sequence_conv": {
        "type": "Conv1d",
        "in_ch": 64,
        "out_ch": 128,
        "kernel_size": 3,
        "stride": 2,
        "padding": 1,
        "purpose": "temporal_downsampling"
    },
    "pooling_strategy": "None (stride-based reduction)",
    "fc_stack": {
        "flatten": true,
        "fc1": 64,
        "fc1_activation": "GELU",
        "fc1_dropout": 0.5,
        "fc2": 64,
        "fc2_activation": "GELU",
        "fc2_dropout": 0.5,
        "head_out": 1
    },
    "regularization": {
        "dropout": 0.5,
        "weight_decay_recommended": true
    },
    "removed": [
        "MaxPooling",
        "GlobalAveragePooling",
        "DeepFCStack"
    ]
}