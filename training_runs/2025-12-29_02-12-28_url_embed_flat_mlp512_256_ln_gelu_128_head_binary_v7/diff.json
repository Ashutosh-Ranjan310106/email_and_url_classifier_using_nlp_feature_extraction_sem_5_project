{
    "baseline": "url_embed_contracting_512_256_128_binary_binary_v6",
    "type": "modify_model",
    "model_family": "url_embedding_classifier",
    "shared_layer": [
        {
            "op": "add",
            "name": "layer_norm_fc1",
            "class": "LayerNorm",
            "params": {
                "normalized_shape": 512
            },
            "after": "fc1",
            "reason": "stabilize large FC activations after flattening"
        },
        {
            "op": "add",
            "name": "gelu_fc1",
            "class": "GELU",
            "after": "layer_norm_fc1",
            "reason": "introduce smooth non-linearity"
        },
        {
            "op": "add",
            "name": "layer_norm_fc2",
            "class": "LayerNorm",
            "params": {
                "normalized_shape": 256
            },
            "after": "fc2",
            "reason": "reduce internal covariate shift"
        },
        {
            "op": "add",
            "name": "gelu_fc2",
            "class": "GELU",
            "after": "layer_norm_fc2",
            "reason": "improve gradient flow in mid-level features"
        }
    ],
    "personal_layer": [
        {
            "op": "add",
            "name": "layer_norm_fc3",
            "class": "LayerNorm",
            "params": {
                "normalized_shape": 128
            },
            "after": "fc3",
            "reason": "regularize personalization subspace"
        },
        {
            "op": "add",
            "name": "gelu_fc3",
            "class": "GELU",
            "after": "layer_norm_fc3",
            "reason": "increase non-linear expressiveness before head"
        },
        {
            "op": "modify",
            "name": "head",
            "class": "Linear",
            "params": {
                "in_features": 128,
                "out_features": 1
            },
            "reason": "binary classification head preserved"
        }
    ],
    "forward": [
        "x = embedding(x)",
        "x = flatten(x, start_dim=1)",
        "x = fc1(x) -> gelu",
        "x = fc2(x) -> layer_norm -> gelu",
        "x = fc3(x) -> gelu",
        "x = head(x)",
        "x = sigmoid(x)"
    ],
    "summary": {
        "changes": [
            "introduced LayerNorm after each major FC block",
            "added GELU activations for smoother non-linearity",
            "kept depth but improved training stability"
        ],
        "expected_effect": [
            "smoother loss curve",
            "better calibration of logits",
            "reduced sensitivity to learning rate"
        ]
    },
    "output": {
        "task": "binary_classification",
        "activation": "sigmoid"
    }
}